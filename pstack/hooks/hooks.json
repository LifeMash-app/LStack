    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/poteto_mode.py\"",
            "timeout": 5,
            "additionalContextLimit": 300
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/poteto_mode.py\"",
            "timeout": 5,
            "additionalContextLimit": 300
          }
        ]
      }
    ]
  }
}
